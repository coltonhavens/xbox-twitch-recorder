{
  "displayName": "Xbox archive missing completed run for 10 hours",
  "enabled": false,
  "combiner": "OR",
  "notificationChannels": [],
  "conditions": [{
    "displayName": "No terminal run event",
    "conditionAbsent": {
      "filter": "resource.type=\"global\" AND metric.type=\"logging.googleapis.com/user/xtr_run_terminal\"",
      "duration": "36000s",
      "aggregations": [{"alignmentPeriod": "3600s", "perSeriesAligner": "ALIGN_SUM"}],
      "trigger": {"count": 1}
    }
  }],
  "alertStrategy": {"autoClose": "86400s"}
}
