# Keep disabled until cloud, OAuth, budget, and acceptance review approved.
RECORDING_ENABLED=false
RECORDING_ROOT=/var/lib/xtr
TWITCH_USER_ID=REPLACE_WITH_OWNER_NUMERIC_ID
TWITCH_CLIENT_ID=REPLACE_WITH_APP_ID
TWITCH_CLIENT_SECRET_FILE=/etc/xtr/twitch-client-secret
DRIVE_OAUTH_FILE=/etc/xtr/drive-authorized-user.json
