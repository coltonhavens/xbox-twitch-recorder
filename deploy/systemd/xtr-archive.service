[Unit]
Description=Completed Twitch VOD batch archive; power off after every exit
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=xtr
Group=xtr
WorkingDirectory=/opt/xtr
EnvironmentFile=/etc/xtr/archive.env
ExecStartPre=+/opt/xtr/venv/bin/python -m recorder.load_secrets
ExecStart=/opt/xtr/venv/bin/python -m recorder.supervisor
# '+' runs only the stop command as root; no sudo for the archive user.
ExecStopPost=+/usr/bin/systemctl --no-block poweroff
RuntimeMaxSec=5h45m
TimeoutStopSec=45s
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xtr /run/xtr
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
